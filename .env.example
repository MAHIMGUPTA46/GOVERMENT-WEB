# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional API key override for Google Maps Platform.
# If not provided, falls back to the provisioned Firebase/GCP API key.
VITE_GOOGLE_MAPS_API_KEY=""

# REAL-TIME & WEBSOCKET CONFIGURATION
REALTIME_ENABLED="true"
REALTIME_TRANSPORT="websocket"
REDIS_URL="redis://localhost:6379/0"
REALTIME_CHANNEL_PREFIX="paimana:realtime"
REALTIME_HEARTBEAT_SECONDS="25"
REALTIME_MAX_CONNECTIONS_PER_USER="5"
REALTIME_RECONNECT_MAX_SECONDS="60"
WS_TOKEN_SECRET="paimana-development-secure-token-secret-2026"

# FRONTEND CLIENT ENVIRONMENT URLS
# Development:
# VITE_API_URL="http://localhost:3000"
# VITE_WS_URL="ws://localhost:3000/api/v1/realtime/ws"
# VITE_SSE_URL="http://localhost:3000/api/v1/realtime/events"
# Production:
# VITE_API_URL="https://api.paimana.mospi.gov.in"
# VITE_WS_URL="wss://api.paimana.mospi.gov.in/api/v1/realtime/ws"
# VITE_SSE_URL="https://api.paimana.mospi.gov.in/api/v1/realtime/events"
